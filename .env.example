# Cấu hình CSDL PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=NAMKHANH
# Docker service name must remain `postgres` (not 127.0.0.1) when deployed with Compose.
DATABASE_URL="postgresql://postgres:123456@postgres:5432/NAMKHANH?schema=public"

# Cấu hình JWT Token
JWT_SECRET="crm_namkhanh_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Cổng khởi chạy
BACKEND_PORT=5000
FRONTEND_PORT=3000
