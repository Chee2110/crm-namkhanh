# Cấu hình CSDL PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=crm_namkhanh
# Cổng máy host (đặt 5433 để tránh đụng độ với các dự án khác dùng 5432)
POSTGRES_HOST_PORT=5433
# Docker service name must remain `postgres` (not 127.0.0.1) when deployed with Compose.
DATABASE_URL="postgresql://postgres:123456@postgres:5432/crm_namkhanh?schema=public"

# Cấu hình Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
# Cổng máy host (đặt 6380 để tránh đụng độ với các dự án khác dùng 6379)
REDIS_HOST_PORT=6380

# Cấu hình JWT Token
JWT_SECRET="crm_namkhanh_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Cổng khởi chạy
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Kích hoạt toàn bộ service trên VPS (Backend + Frontend)
COMPOSE_PROFILES=prod
