# Cấu hình CSDL PostgreSQL
POSTGRES_USER=crm_user
# Use a long, unique secret. URL-encode special characters in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password
POSTGRES_DB=crm_namkhanh
# Docker service name must remain `postgres` (not 127.0.0.1) when deployed with Compose.
DATABASE_URL="postgresql://crm_user:replace_with_a_long_unique_database_password@postgres:5432/crm_namkhanh?schema=public"

# Cấu hình JWT Token
JWT_SECRET="replace_with_a_long_unique_jwt_secret"
JWT_EXPIRES_IN="7d"

# Cổng khởi chạy
BACKEND_PORT=5000
FRONTEND_PORT=3000
